exports[`RSS characterization > loading state before subscriptions arrive > loading 1`] = `
"<div>
<div class="space-y-6">
<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
<div>
<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">RSS</h1>
