<button class="px-4 py-2 text-sm rounded bg-gray-800 text-white hover:bg-gray-700 disabled:opacity-50">Import from server</button>
<button class="px-4 py-2 text-sm rounded bg-[var(--color-ocean-600)] text-white hover:bg-[var(--color-ocean-700)] disabled:opacity-50">Publish to server</button>
<div class="w-px h-6 bg-gray-300 dark:bg-gray-700 mx-1">
</div>
