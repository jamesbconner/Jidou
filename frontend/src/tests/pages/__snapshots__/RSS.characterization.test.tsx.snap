<button class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Edit</button>
<button class="text-xs text-red-400 dark:text-red-400 hover:underline">Delete</button>
</div>
</td>
</tr>
<tr class="hover:bg-gray-50 dark:hover:bg-gray-900">
<td class="px-3 py-2 font-mono text-xs text-gray-500 dark:text-gray-400">—</td>
