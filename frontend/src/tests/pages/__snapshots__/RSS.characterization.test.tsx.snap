<button class="pb-3 text-sm font-medium capitalize border-b-2 transition-colors border-[var(--color-ocean-600)] text-[var(--color-ocean-600)] dark:border-[var(--color-ocean-400)] dark:text-[var(--color-ocean-400)]">Subscriptions (4)</button>
<button class="pb-3 text-sm font-medium capitalize border-b-2 transition-colors border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-500 dark:hover:text-gray-300 dark:hover:border-gray-700">Feeds (2)</button>
<button class="pb-3 text-sm font-medium capitalize border-b-2 transition-colors border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-500 dark:hover:text-gray-300 dark:hover:border-gray-700">Recommendations</button>
</nav>
</div>
<section>
<div class="flex flex-wrap gap-2 items-center mb-3">
<input placeholder="Search name…" class="border rounded px-2 py-1 text-sm w-44 focus:outline-none focus:ring-2 focus:ring-[var(--color-ocean-400)] dark:bg-gray-800 dark:text-gray-100" type="search" value="">
<select class="border rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ocean-400)] dark:bg-gray-800 dark:text-gray-100">
<option value="all">Any enabled</option>
<option value="enabled">Enabled</option>
<option value="disabled">Disabled</option>
</select>
<select class="border rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ocean-400)] dark:bg-gray-800 dark:text-gray-100">
<option value="all">Any active</option>
<option value="active">Active</option>
<option value="inactive">Inactive</option>
</select>
<select aria-label="Key filter" class="border rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ocean-400)] dark:bg-gray-800 dark:text-gray-100">
<option value="all">Any key</option>
<option value="stub">Stub (no key)</option>
<option value="keyed">Has key</option>
</select>
<select class="border rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ocean-400)] dark:bg-gray-800 dark:text-gray-100">
<option value="all">All feeds</option>
<option value="unlinked">Unlinked</option>
<option value="10">Feed Ten</option>
<option value="11">Feed Eleven</option>
</select>
<span class="text-xs text-gray-400 dark:text-gray-500 ml-1">2 / 4</span>
</div>
<div class="border rounded-lg p-3">
<div class="flex justify-end mb-2">
<button class="px-3 py-1.5 text-sm rounded bg-[var(--color-ocean-600)] text-white hover:bg-[var(--color-ocean-700)] dark:hover:bg-[var(--color-ocean-500)]">+ New Subscription</button>
</div>
<div class="overflow-x-auto">
<table class="w-full text-sm text-left">
<thead class="bg-gray-50 dark:bg-gray-900 text-xs text-gray-500 dark:text-gray-400 uppercase">
<tr>
<th class="px-3 py-2 w-16">Key</th>
<th class="px-3 py-2">Name / Show</th>
<th class="px-3 py-2 w-20" title="Included in the published YaRSS2 config. Stubs are excluded until explicitly enabled.">Enabled</th>
<th class="px-3 py-2 w-24" title="Jidou controls this flag. Active subscriptions are treated as live by the downloader. Stubs are always inactive.">Active</th>
<th class="px-3 py-2 w-36">
</th>
</tr>
</thead>
<tbody class="divide-y divide-gray-100 dark:divide-gray-800">
<tr class="hover:bg-gray-50 dark:hover:bg-gray-900">
<td class="px-3 py-2 font-mono text-xs text-gray-500 dark:text-gray-400">1</td>
<td class="px-3 py-2">
<button class="font-medium text-left text-gray-900 dark:text-gray-100 hover:text-[var(--color-ocean-600)] dark:hover:text-[var(--color-ocean-400)] hover:underline" title="Edit subscription">Alpha Linked</button>
</td>
<td class="px-3 py-2">
<button class="w-10 h-5 rounded-full transition-colors bg-green-500" title="Enabled — included in published config. Click to disable." aria-label="Enabled in config — click to disable" aria-pressed="true">
<span class="block w-4 h-4 bg-white rounded-full shadow transform transition-transform mx-0.5 translate-x-5">
</span>
</button>
</td>
<td class="px-3 py-2">
<button title="Active — downloader treats this as live. Click to deactivate." aria-label="Active — click to deactivate" aria-pressed="true">
<span class="badge bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300 hover:ring-1 hover:ring-green-400">active</span>
</button>
</td>
<td class="px-3 py-2">
<div class="flex gap-2 items-center">
<button class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Edit</button>
<button class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Preview</button>
</div>
</td>
</tr>
<tr class="hover:bg-gray-50 dark:hover:bg-gray-900">
<td class="px-3 py-2 font-mono text-xs text-gray-500 dark:text-gray-400">4</td>
<td class="px-3 py-2">
<button class="font-medium text-left text-gray-900 dark:text-gray-100 hover:text-[var(--color-ocean-600)] dark:hover:text-[var(--color-ocean-400)] hover:underline" title="Edit subscription">Delta Disabled</button>
</td>
<td class="px-3 py-2">
<button class="w-10 h-5 rounded-full transition-colors bg-gray-300 dark:bg-gray-700" title="Disabled — not included in published config. Click to enable." aria-label="Disabled from config — click to enable" aria-pressed="false">
<span class="block w-4 h-4 bg-white rounded-full shadow transform transition-transform mx-0.5 translate-x-0">
</span>
</button>
</td>
<td class="px-3 py-2">
<button title="Active — downloader treats this as live. Click to deactivate." aria-label="Active — click to deactivate" aria-pressed="true">
<span class="badge bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300 hover:ring-1 hover:ring-green-400">active</span>
</button>
</td>
<td class="px-3 py-2">
<div class="flex gap-2 items-center">
<button class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Edit</button>
<button class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Preview</button>
<button class="text-xs text-red-400 hover:underline">Delete</button>
</div>
</td>
</tr>
</tbody>
</table>
</div>
</div>
</section>
</div>
</div>"
`;

