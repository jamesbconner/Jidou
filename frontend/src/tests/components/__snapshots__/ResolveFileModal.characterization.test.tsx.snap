exports[`ResolveFileModal characterization: title (refine) mode > refine seeds the query, searches after the debounce, filters non-tv/movie, and drops suggestions 1`] = `"<div><div class="overlay" role="dialog" aria-modal="true" aria-labelledby="resolve-file-title"><div class="w-full max-w-2xl panel-dark overflow-hidden flex flex-col max-h-[90vh]"><div class="px-5 py-4 border-b border-zinc-700 flex items-center justify-between"><h2 id="resolve-file-title" class="text-sm font-semibold text-zinc-100">Resolve unmatched file</h2><button aria-label="Close dialog" class="text-zinc-400 hover:text-zinc-200 text-lg leading-none">✕</button></div><div class="overflow-y-auto flex-1 px-5 py-4 space-y-5"><div class="bg-zinc-800 rounded p-3 space-y-1"><div class="text-xs text-zinc-400">Filename</div><div class="font-mono text-xs text-zinc-200 truncate">Example.Show.S01E01.mkv</div><div class="text-xs text-zinc-400 mt-1">Parsed as</div><div class="text-xs text-zinc-300">Example Show</div></div><div class="space-y-2"><div class="flex items-center gap-2"><label class="text-xs text-zinc-400">Search TMDB</label><button class="text-xs text-zinc-500 hover:text-zinc-300">back to suggestions</button></div><input placeholder="Search TMDB..." class="w-full bg-zinc-800 border border-zinc-600 rounded px-3 py-1.5 text-sm text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-[var(--color-ocean-500)]" type="text" value="Example Show"></div><div class="space-y-2"><div class="grid grid-cols-2 sm:grid-cols-3 gap-2"><button class="flex flex-col rounded border text-left overflow-hidden transition-colors border-zinc-700 bg-zinc-800 hover:border-zinc-500"><div class="w-full aspect-[2/3] bg-zinc-700 flex items-center justify-center text-zinc-500 text-xs">No image</div><div class="p-2 space-y-0.5"><div class="text-xs font-medium text-zinc-200 line-clamp-2 leading-tight">Found Show</div><div class="text-xs text-zinc-500">2020 · tv</div></div></button><button class="flex flex-col rounded border text-left overflow-hidden transition-colors border-zinc-700 bg-zinc-800 hover:border-zinc-500"><img alt="Found Movie" class="w-full aspect-[2/3] object-cover" src="/api/images/w185/m.jpg"><div class="p-2 space-y-0.5"><div class="text-xs font-medium text-zinc-200 line-clamp-2 leading-tight">Found Movie</div><div class="text-xs text-zinc-500">2021 · movie</div></div></button></div></div></div><div class="px-5 py-3 border-t border-zinc-700 flex items-center justify-between"><button class="text-xs text-zinc-400 hover:text-zinc-200 disabled:opacity-50">Reset for auto re-match</button><div class="flex gap-2"><button class="btn px-3 py-1.5 text-xs border border-zinc-600 text-zinc-300 hover:bg-zinc-700">Cancel</button><button class="btn px-3 py-1.5 text-xs bg-[var(--color-ocean-600)] text-white hover:bg-[var(--color-ocean-500)]" disabled="">Confirm match</button></div></div></div></div></div>"`;
