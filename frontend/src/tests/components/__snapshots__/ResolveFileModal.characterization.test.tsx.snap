exports[`ResolveFileModal characterization: TMDB ID mode > a failed lookup shows the lookup error instead of "No results found." 1`] = `"<div><div class="overlay" role="dialog" aria-modal="true" aria-labelledby="resolve-file-title"><div class="w-full max-w-2xl panel-dark overflow-hidden flex flex-col max-h-[90vh]"><div class="px-5 py-4 border-b border-zinc-700 flex items-center justify-between"><h2 id="resolve-file-title" class="text-sm font-semibold text-zinc-100">Resolve unmatched file</h2><button aria-label="Close dialog" class="text-zinc-400 hover:text-zinc-200 text-lg leading-none">✕</button></div><div class="overflow-y-auto flex-1 px-5 py-4 space-y-5"><div class="bg-zinc-800 rounded p-3 space-y-1"><div class="text-xs text-zinc-400">Filename</div><div class="font-mono text-xs text-zinc-200 truncate">Example.Show.S01E01.mkv</div><div class="text-xs text-zinc-400 mt-1">Parsed as</div><div class="text-xs text-zinc-300">Example Show</div></div><div class="space-y-2"><div class="flex items-center gap-2"><label class="text-xs text-zinc-400">Search TMDB</label><button class="text-xs text-zinc-500 hover:text-zinc-300">back to suggestions</button></div><div class="flex items-center gap-2"><input min="1" placeholder="TMDB ID, e.g. 1668" class="flex-1 bg-zinc-800 border border-zinc-600 rounded px-3 py-1.5 text-sm text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-[var(--color-ocean-500)]" type="number" value="5"><select class="bg-zinc-800 border border-zinc-600 rounded px-2 py-1.5 text-sm text-zinc-200 focus:outline-none focus:border-[var(--color-ocean-500)]"><option value="tv">TV</option><option value="movie">Movie</option></select></div></div><div class="space-y-2"><div class="text-xs text-red-400 py-2">no such id</div><div class="grid grid-cols-2 sm:grid-cols-3 gap-2"></div></div></div><div class="px-5 py-3 border-t border-zinc-700 flex items-center justify-between"><button class="text-xs text-zinc-400 hover:text-zinc-200 disabled:opacity-50">Reset for 